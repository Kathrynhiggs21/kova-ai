{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the memory entry"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the memory was recorded"
    },
    "source": {
      "type": "string",
      "description": "Origin of the memory information"
    },
    "content": {
      "type": "string",
      "description": "Actual memory content"
    }
  },
  "required": ["id", "timestamp", "content"]
}
